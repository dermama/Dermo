{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm run vercel-build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/trpc.js": {
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/api/trpc/(.*)",
      "dest": "/api/trpc.js"
    },
    {
      "src": "/api/trpc",
      "dest": "/api/trpc.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
